{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "animated-counter",
  "type": "registry:ui",
  "title": "Animated Counter",
  "description": "平静物理微动效组件：Animated Counter",
  "categories": [
    "ui"
  ],
  "dependencies": [
    "motion-v"
  ],
  "registryDependencies": [
    "https://raw.githubusercontent.com/NingZeStudio/uiarc-vue/main/public/r/arc-foundation.json"
  ],
  "files": [
    {
      "path": "registry/components/animated-counter/AnimatedCounter.vue",
      "type": "registry:ui",
      "target": "~/components/ui/animated-counter/AnimatedCounter.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport { motion, AnimatePresence } from \"motion-v\";\nimport { motionTokens } from \"../motion-tokens\";\nimport { useReducedMotion } from \"../use-reduced-motion\";\nimport styles from \"./animated-counter.module.css\";\n\nexport interface AnimatedCounterProps {\n  value: number;\n  label?: string;\n  prefix?: string;\n  suffix?: string;\n  decimals?: number;\n  locale?: string;\n}\n\nconst props = withDefaults(defineProps<AnimatedCounterProps>(), {\n  decimals: 0,\n  locale: \"en-US\",\n});\n\nconst prefersReduced = useReducedMotion();\n\nconst formattedParts = computed(() => {\n  const formatter = new Intl.NumberFormat(props.locale, {\n    minimumFractionDigits: props.decimals,\n    maximumFractionDigits: props.decimals,\n    useGrouping: true,\n  });\n\n  const parts = formatter.formatToParts(props.value);\n  let place = parts.reduce(\n    (count, part) => count + (part.type === \"integer\" ? part.value.length : 0),\n    0\n  );\n  let fraction = 0;\n\n  return parts.flatMap((part, index) => {\n    if (part.type === \"integer\") {\n      return [...part.value].map((char) => ({\n        key: `i-${--place}-${char}`,\n        char,\n        isDigit: true,\n      }));\n    }\n    if (part.type === \"fraction\") {\n      return [...part.value].map((char) => ({\n        key: `f-${fraction++}-${char}`,\n        char,\n        isDigit: true,\n      }));\n    }\n    return [\n      {\n        key: `sym-${part.type}-${index}`,\n        char: part.value,\n        isDigit: false,\n      },\n    ];\n  });\n});\n\nconst digitVariants = {\n  enter: {\n    y: \"0.5em\",\n    opacity: 0,\n    filter: `blur(${motionTokens.blur.soft}px)`,\n  },\n  center: {\n    y: \"0em\",\n    opacity: 1,\n    filter: \"blur(0px)\",\n    transition: {\n      ...motionTokens.spring.snappy,\n    },\n  },\n  exit: {\n    y: \"-0.5em\",\n    opacity: 0,\n    filter: `blur(${motionTokens.blur.soft}px)`,\n    transition: {\n      duration: motionTokens.duration.fast,\n      ease: [...motionTokens.ease.standard],\n    },\n  },\n};\n</script>\n\n<template>\n  <div :class=\"styles.counter\">\n    <span v-if=\"label\" :class=\"styles.label\">{{ label }}</span>\n\n    <span :class=\"styles.value\">\n      <span v-if=\"prefix\" :class=\"styles.affix\">{{ prefix }}</span>\n\n      <template v-for=\"item in formattedParts\" :key=\"item.key\">\n        <span v-if=\"item.isDigit\" :class=\"styles.column\">\n          <span :class=\"styles.sizer\">0</span>\n          <AnimatePresence mode=\"popLayout\" :initial=\"false\">\n            <motion.span\n              :key=\"item.char\"\n              :class=\"styles.glyph\"\n              :variants=\"prefersReduced ? undefined : digitVariants\"\n              initial=\"enter\"\n              animate=\"center\"\n              exit=\"exit\"\n            >\n              {{ item.char }}\n            </motion.span>\n          </AnimatePresence>\n        </span>\n        <span v-else :class=\"styles.symbol\">{{ item.char }}</span>\n      </template>\n\n      <span v-if=\"suffix\" :class=\"styles.affix\">{{ suffix }}</span>\n    </span>\n  </div>\n</template>\n"
    },
    {
      "path": "registry/components/animated-counter/animated-counter.module.css",
      "type": "registry:ui",
      "target": "~/components/ui/animated-counter/animated-counter.module.css",
      "content": ".counter {\n  position: relative;\n  display: inline-flex;\n  flex-direction: column;\n  color: var(--foreground);\n  font-family: var(--font-display, sans-serif);\n  font-size: var(--text-3xl);\n  font-weight: 500;\n  letter-spacing: var(--tracking-display);\n  line-height: 1;\n  font-variant-numeric: tabular-nums;\n  user-select: none;\n}\n\n.label {\n  margin-bottom: 8px;\n  color: var(--text-muted);\n  font-family: var(--font-body, sans-serif);\n  font-size: var(--text-xs);\n  font-weight: 400;\n  letter-spacing: normal;\n  line-height: var(--leading-body);\n}\n\n.value {\n  display: inline-flex;\n  align-items: baseline;\n  white-space: nowrap;\n}\n\n.column {\n  position: relative;\n  display: inline-flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  height: 1.15em;\n  overflow: hidden;\n}\n\n.symbol {\n  display: inline-block;\n  opacity: 0.8;\n}\n\n.sizer {\n  visibility: hidden;\n  user-select: none;\n  pointer-events: none;\n}\n\n.glyph {\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.affix {\n  color: var(--text-secondary);\n  font-size: 0.7em;\n  margin: 0 4px;\n}\n"
    },
    {
      "path": "registry/components/animated-counter/index.ts",
      "type": "registry:ui",
      "target": "~/components/ui/animated-counter/index.ts",
      "content": "export { default as AnimatedCounter } from \"./AnimatedCounter.vue\";\nexport type { AnimatedCounterProps } from \"./AnimatedCounter.vue\";\n"
    }
  ]
}