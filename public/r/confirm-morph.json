{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "confirm-morph",
  "type": "registry:ui",
  "title": "Confirm Morph",
  "description": "平静物理微动效组件：Confirm Morph",
  "categories": [
    "ui"
  ],
  "dependencies": [
    "motion-v",
    "@vueuse/core"
  ],
  "registryDependencies": [
    "https://raw.githubusercontent.com/NingZeStudio/uiarc-vue/main/public/r/arc-foundation.json"
  ],
  "files": [
    {
      "path": "registry/components/confirm-morph/ConfirmMorph.vue",
      "type": "registry:ui",
      "target": "~/components/ui/confirm-morph/ConfirmMorph.vue",
      "content": "<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport { motion, AnimatePresence } from \"motion-v\";\nimport { onClickOutside } from \"@vueuse/core\";\nimport { motionTokens } from \"@/registry/motion-tokens\";\nimport { useMorphWidth } from \"@/registry/composables/use-morph-width\";\nimport { useReducedMotion } from \"@/registry/composables/use-reduced-motion\";\nimport styles from \"./confirm-morph.module.css\";\n\nexport type ConfirmMorphState = \"idle\" | \"confirming\" | \"pending\" | \"done\" | \"error\";\n\nexport interface ConfirmMorphProps {\n  label?: string;\n  prompt?: string;\n  confirmLabel?: string;\n  cancelLabel?: string;\n  pendingLabel?: string;\n  doneLabel?: string;\n  undoLabel?: string;\n  tone?: \"danger\" | \"neutral\";\n  confirmTimeout?: number;\n  onConfirm?: () => Promise<unknown> | void;\n  onUndo?: () => Promise<unknown> | void;\n}\n\nconst props = withDefaults(defineProps<ConfirmMorphProps>(), {\n  label: \"Delete\",\n  prompt: \"Are you sure?\",\n  confirmLabel: \"Confirm\",\n  cancelLabel: \"Cancel\",\n  pendingLabel: \"Deleting...\",\n  doneLabel: \"Deleted\",\n  undoLabel: \"Undo\",\n  tone: \"danger\",\n  confirmTimeout: 4000,\n});\n\nconst emit = defineEmits<{\n  (e: \"stateChange\", state: ConfirmMorphState): void;\n}>();\n\nconst prefersReduced = useReducedMotion();\nconst rootRef = ref<HTMLDivElement | null>(null);\nconst surfaceRef = ref<HTMLDivElement | null>(null);\nconst currentState = ref<ConfirmMorphState>(\"idle\");\nlet timeoutTimer: any = null;\n\nconst setState = (next: ConfirmMorphState) => {\n  currentState.value = next;\n  emit(\"stateChange\", next);\n\n  clearTimeout(timeoutTimer);\n  if (next === \"confirming\" && props.confirmTimeout > 0) {\n    timeoutTimer = setTimeout(() => {\n      if (currentState.value === \"confirming\") {\n        setState(\"idle\");\n      }\n    }, props.confirmTimeout);\n  }\n};\n\nonClickOutside(rootRef, () => {\n  if (currentState.value === \"confirming\") {\n    setState(\"idle\");\n  }\n});\n\nconst handleTriggerClick = () => {\n  setState(\"confirming\");\n};\n\nconst handleCancel = () => {\n  setState(\"idle\");\n};\n\nconst handleConfirm = async () => {\n  setState(\"pending\");\n  try {\n    if (props.onConfirm) {\n      await props.onConfirm();\n    }\n    setState(\"done\");\n  } catch {\n    setState(\"error\");\n  }\n};\n\nconst handleUndo = async () => {\n  setState(\"pending\");\n  try {\n    if (props.onUndo) {\n      await props.onUndo();\n    }\n    setState(\"idle\");\n  } catch {\n    setState(\"error\");\n  }\n};\n\n// 尺寸自适应平滑拉伸\nconst morphWidth = useMorphWidth(\n  surfaceRef,\n  () => currentState.value,\n  { disabled: prefersReduced }\n);\n\nconst faceVariants = {\n  hidden: {\n    opacity: 0,\n    y: \"0.3em\",\n    filter: `blur(${motionTokens.blur.subtle}px)`,\n  },\n  shown: {\n    opacity: 1,\n    y: \"0em\",\n    filter: \"blur(0px)\",\n    transition: {\n      duration: motionTokens.duration.fast,\n      ease: [...motionTokens.ease.enter],\n    },\n  },\n  gone: {\n    opacity: 0,\n    y: \"-0.3em\",\n    filter: `blur(${motionTokens.blur.subtle}px)`,\n    transition: {\n      duration: motionTokens.duration.instant,\n    },\n  },\n};\n</script>\n\n<template>\n  <div\n    ref=\"rootRef\"\n    :class=\"styles.root\"\n    :data-tone=\"tone\"\n    :data-state=\"currentState\"\n  >\n    <div\n      ref=\"surfaceRef\"\n      :class=\"styles.surface\"\n      :style=\"{ width: morphWidth === 'auto' ? 'auto' : morphWidth }\"\n    >\n      <AnimatePresence mode=\"popLayout\" :initial=\"false\">\n        <!-- 1. 静止态 (Idle) -->\n        <motion.div\n          v-if=\"currentState === 'idle'\"\n          key=\"idle\"\n          :class=\"styles.face\"\n          :variants=\"prefersReduced ? undefined : faceVariants\"\n          initial=\"hidden\"\n          animate=\"shown\"\n          exit=\"gone\"\n        >\n          <button type=\"button\" :class=\"styles.btn\" @click=\"handleTriggerClick\">\n            <slot>{{ label }}</slot>\n          </button>\n        </motion.div>\n\n        <!-- 2. 询问态 (Confirming) -->\n        <motion.div\n          v-else-if=\"currentState === 'confirming'\"\n          key=\"confirming\"\n          :class=\"styles.face\"\n          :variants=\"prefersReduced ? undefined : faceVariants\"\n          initial=\"hidden\"\n          animate=\"shown\"\n          exit=\"gone\"\n        >\n          <span>{{ prompt }}</span>\n          <button type=\"button\" :class=\"styles.btn\" @click=\"handleCancel\">\n            {{ cancelLabel }}\n          </button>\n          <button\n            type=\"button\"\n            :class=\"[styles.btn, styles.confirmBtn]\"\n            @click=\"handleConfirm\"\n          >\n            {{ confirmLabel }}\n          </button>\n        </motion.div>\n\n        <!-- 3. 进行态 (Pending) -->\n        <motion.div\n          v-else-if=\"currentState === 'pending'\"\n          key=\"pending\"\n          :class=\"styles.face\"\n          :variants=\"prefersReduced ? undefined : faceVariants\"\n          initial=\"hidden\"\n          animate=\"shown\"\n          exit=\"gone\"\n        >\n          <span :class=\"styles.spinner\" />\n          <span>{{ pendingLabel }}</span>\n        </motion.div>\n\n        <!-- 4. 完成态带撤销 (Done with Undo) -->\n        <motion.div\n          v-else-if=\"currentState === 'done'\"\n          key=\"done\"\n          :class=\"styles.face\"\n          :variants=\"prefersReduced ? undefined : faceVariants\"\n          initial=\"hidden\"\n          animate=\"shown\"\n          exit=\"gone\"\n        >\n          <span>{{ doneLabel }}</span>\n          <button\n            v-if=\"onUndo\"\n            type=\"button\"\n            :class=\"[styles.btn, styles.undoBtn]\"\n            @click=\"handleUndo\"\n          >\n            {{ undoLabel }}\n          </button>\n        </motion.div>\n\n        <!-- 5. 异常态 (Error) -->\n        <motion.div\n          v-else-if=\"currentState === 'error'\"\n          key=\"error\"\n          :class=\"styles.face\"\n          :variants=\"prefersReduced ? undefined : faceVariants\"\n          initial=\"hidden\"\n          animate=\"shown\"\n          exit=\"gone\"\n        >\n          <span>Action failed</span>\n          <button type=\"button\" :class=\"styles.btn\" @click=\"handleCancel\">\n            Close\n          </button>\n        </motion.div>\n      </AnimatePresence>\n    </div>\n  </div>\n</template>\n"
    },
    {
      "path": "registry/components/confirm-morph/confirm-morph.module.css",
      "type": "registry:ui",
      "target": "~/components/ui/confirm-morph/confirm-morph.module.css",
      "content": ".root {\n  position: relative;\n  display: inline-flex;\n  min-width: 0;\n  max-width: 100%;\n  vertical-align: middle;\n  color: var(--foreground);\n  font-family: var(--font-body, sans-serif);\n  font-size: var(--text-sm);\n  letter-spacing: -0.005em;\n  line-height: 1;\n  -webkit-tap-highlight-color: transparent;\n  user-select: none;\n}\n\n.surface {\n  position: relative;\n  display: flex;\n  height: var(--control-height-sm);\n  max-width: 100%;\n  align-items: center;\n  justify-content: center;\n  overflow: clip;\n  border-radius: var(--radius-pill);\n  background: var(--surface);\n  box-shadow: var(--shadow-resting);\n  border: 1px solid var(--border);\n  transition:\n    background-color var(--duration-standard) var(--ease-standard),\n    border-color var(--duration-standard) var(--ease-standard),\n    box-shadow var(--duration-standard) var(--ease-standard);\n}\n\n.root[data-tone=\"danger\"] .surface {\n  background: color-mix(in oklch, var(--danger) 6%, var(--surface));\n  border-color: color-mix(in oklch, var(--danger) 22%, var(--border));\n}\n\n.root[data-tone=\"danger\"][data-state=\"confirming\"] .surface {\n  background: color-mix(in oklch, var(--danger) 10%, var(--surface));\n  border-color: color-mix(in oklch, var(--danger) 35%, var(--border));\n  box-shadow: 0 4px 14px color-mix(in oklch, var(--danger) 12%, transparent);\n}\n\n.face {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-2);\n  padding: 0 var(--space-3);\n  white-space: nowrap;\n  font-size: var(--text-xs);\n  font-weight: 500;\n}\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 4px;\n  border: 0;\n  background: transparent;\n  color: inherit;\n  font: inherit;\n  font-weight: 500;\n  cursor: pointer;\n  padding: 2px 6px;\n  border-radius: calc(var(--radius-pill) - 2px);\n  transition:\n    background-color var(--duration-fast) var(--ease-standard),\n    color var(--duration-fast) var(--ease-standard);\n}\n\n.btn:hover {\n  background: var(--surface-muted);\n}\n\n.confirmBtn {\n  background: var(--danger);\n  color: #fff !important;\n}\n\n.confirmBtn:hover {\n  opacity: 0.9;\n}\n\n.undoBtn {\n  color: var(--accent);\n}\n\n.undoBtn:hover {\n  text-decoration: underline;\n}\n\n.spinner {\n  display: inline-block;\n  width: 14px;\n  height: 14px;\n  border: 2px solid currentColor;\n  border-right-color: transparent;\n  border-radius: 50%;\n  animation: spin 0.65s linear infinite;\n}\n\n@keyframes spin {\n  from {\n    transform: rotate(0deg);\n  }\n  to {\n    transform: rotate(360deg);\n  }\n}\n"
    },
    {
      "path": "registry/components/confirm-morph/index.ts",
      "type": "registry:ui",
      "target": "~/components/ui/confirm-morph/index.ts",
      "content": "export { default as ConfirmMorph } from \"./ConfirmMorph.vue\";\nexport type { ConfirmMorphProps, ConfirmMorphState } from \"./ConfirmMorph.vue\";\n"
    }
  ]
}