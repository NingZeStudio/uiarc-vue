{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "empty-state",
  "type": "registry:ui",
  "title": "Empty State",
  "description": "平静物理微动效组件：Empty State",
  "categories": [
    "ui"
  ],
  "dependencies": [
    "motion-v",
    "lucide-vue-next"
  ],
  "registryDependencies": [
    "https://raw.githubusercontent.com/NingZeStudio/uiarc-vue/main/public/r/arc-foundation.json"
  ],
  "files": [
    {
      "path": "registry/components/empty-state/EmptyState.vue",
      "type": "registry:ui",
      "target": "~/components/ui/empty-state/EmptyState.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport { motion, AnimatePresence } from \"motion-v\";\nimport { Folder } from \"lucide-vue-next\";\nimport { motionTokens } from \"@/registry/motion-tokens\";\nimport { useReducedMotion } from \"@/registry/composables/use-reduced-motion\";\nimport styles from \"./empty-state.module.css\";\n\nexport interface EmptyStateProps {\n  title: string;\n  description: string;\n  label?: string;\n  class?: any;\n}\n\nconst props = defineProps<EmptyStateProps>();\nconst prefersReduced = useReducedMotion();\n</script>\n\n<template>\n  <div\n    :class=\"[styles.state, props.class]\"\n    role=\"region\"\n    :aria-label=\"label ?? title\"\n  >\n    <div :class=\"styles.iconWrap\">\n      <AnimatePresence mode=\"popLayout\" :initial=\"false\">\n        <motion.div\n          :key=\"title\"\n          :class=\"styles.icon\"\n          :initial=\"\n            prefersReduced\n              ? { opacity: 0 }\n              : { opacity: 0, scale: 0.6, filter: `blur(${motionTokens.blur.subtle}px)` }\n          \"\n          :animate=\"{ opacity: 1, scale: 1, filter: 'blur(0px)' }\"\n          :exit=\"\n            prefersReduced\n              ? { opacity: 0 }\n              : { opacity: 0, scale: 0.6, filter: `blur(${motionTokens.blur.subtle}px)` }\n          \"\n          :transition=\"\n            prefersReduced ? { duration: 0 } : motionTokens.spring.snappy\n          \"\n        >\n          <slot name=\"icon\">\n            <Folder :size=\"24\" :stroke-width=\"1.6\" />\n          </slot>\n        </motion.div>\n      </AnimatePresence>\n    </div>\n\n    <div :class=\"styles.textGroup\">\n      <AnimatePresence mode=\"popLayout\" :initial=\"false\">\n        <motion.h3\n          :key=\"title\"\n          :class=\"styles.title\"\n          :initial=\"\n            prefersReduced\n              ? { opacity: 0 }\n              : { opacity: 0, y: '0.3em', filter: `blur(${motionTokens.blur.soft}px)` }\n          \"\n          :animate=\"{ opacity: 1, y: '0em', filter: 'blur(0px)' }\"\n          :exit=\"\n            prefersReduced\n              ? { opacity: 0 }\n              : { opacity: 0, y: '-0.3em', filter: `blur(${motionTokens.blur.subtle}px)` }\n          \"\n          :transition=\"{\n            duration: prefersReduced ? 0 : motionTokens.duration.standard,\n            ease: [...motionTokens.ease.enter],\n          }\"\n        >\n          {{ title }}\n        </motion.h3>\n      </AnimatePresence>\n\n      <AnimatePresence mode=\"popLayout\" :initial=\"false\">\n        <motion.p\n          :key=\"description\"\n          :class=\"styles.description\"\n          :initial=\"\n            prefersReduced\n              ? { opacity: 0 }\n              : { opacity: 0, y: '0.3em', filter: `blur(${motionTokens.blur.soft}px)` }\n          \"\n          :animate=\"{ opacity: 1, y: '0em', filter: 'blur(0px)' }\"\n          :exit=\"\n            prefersReduced\n              ? { opacity: 0 }\n              : { opacity: 0, y: '-0.3em', filter: `blur(${motionTokens.blur.subtle}px)` }\n          \"\n          :transition=\"{\n            duration: prefersReduced ? 0 : motionTokens.duration.standard,\n            ease: [...motionTokens.ease.enter],\n            delay: 0.05,\n          }\"\n        >\n          {{ description }}\n        </motion.p>\n      </AnimatePresence>\n    </div>\n\n    <div v-if=\"$slots.action\" :class=\"styles.action\">\n      <slot name=\"action\" />\n    </div>\n  </div>\n</template>\n"
    },
    {
      "path": "registry/components/empty-state/empty-state.module.css",
      "type": "registry:ui",
      "target": "~/components/ui/empty-state/empty-state.module.css",
      "content": ".root { display: flex; width: 100%; flex-direction: column; align-items: center; padding: clamp(var(--space-8), 8vw, var(--space-12)) var(--space-5); text-align: center; }\n.icon { position: relative; display: grid; width: var(--space-12); height: var(--space-12); place-items: center; border: 1px solid var(--border); border-radius: var(--radius-panel); background: var(--surface-muted); color: var(--text-secondary); animation: empty-state-icon var(--duration-considered) var(--ease-enter) both; }\n.glyph { display: grid; place-items: center; }\n.frame { width: 100%; max-width: 100%; }\n.copy { display: flow-root; }\n.root h3 { position: relative; margin: var(--space-5) 0 0; color: var(--foreground); font-size: var(--text-base); font-weight: 500; line-height: var(--leading-body); }\n.root p { position: relative; max-width: 18rem; margin: var(--space-2) auto 0; color: var(--text-secondary); font-size: var(--text-sm); line-height: var(--leading-body); }\n/* Centered copy wraps into even lines, so a new description never leaves a single word hanging. */\n.line { display: block; text-wrap: balance; }\n.action { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-top: var(--space-5); }\n/* The icon settles in once when the state first appears; later changes crossfade in place. */\n@keyframes empty-state-icon { from { opacity: 0; transform: scale(.92); } to { opacity: 1; transform: scale(1); } }\n@media (prefers-reduced-motion: reduce) { .icon { animation: none; } }\n"
    },
    {
      "path": "registry/components/empty-state/index.ts",
      "type": "registry:ui",
      "target": "~/components/ui/empty-state/index.ts",
      "content": "export { default as EmptyState } from \"./EmptyState.vue\";\nexport * from \"./EmptyState.vue\";\n"
    }
  ]
}